generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth maison (identifiant + mot de passe géré par l'admin) — voir
// src/lib/auth/. Pas d'OAuth, pas d'email : le compte est créé et transmis
// entre promotions sans dépendre d'une adresse professionnelle qui expire.
// ---------------------------------------------------------------------------

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Domain model — see docs/CONCEPTION.md section 4
// ---------------------------------------------------------------------------

enum UserRole {
  PARTICIPANT
  ADMIN
  DIRECTEUR
}

/// name sert à la fois d'identifiant de connexion (ex. "Adam Dupont") et
/// d'affichage — un seul champ, pas de duplication entre "username" et "name".
model User {
  id                 String    @id @default(cuid())
  name               String    @unique
  passwordHash       String
  /// Vrai juste après la création du compte par l'admin (mot de passe
  /// temporaire) — force le changement de mot de passe à la première
  /// connexion, avant tout autre accès (voir src/proxy.ts).
  mustChangePassword Boolean   @default(false)
  role               UserRole  @default(PARTICIPANT)
  /// Photo de profil encodée en data URL (base64) — pas de stockage objet
  /// externe pour rester sur l'hébergement gratuit Vercel+Neon existant.
  /// Redimensionnée/compressée côté client avant envoi (voir avatar-upload.ts).
  avatarUrl          String?   @db.Text
  createdAt          DateTime  @default(now())
  /// Dernière date (UTC, tronquée) de visite du dashboard/badges — série de
  /// connexions consécutives, voir recordDailyVisit(). Nul tant que
  /// l'utilisateur n'a jamais visité une page qui l'enregistre.
  lastVisitDate      DateTime? @db.Date
  currentStreakDays  Int       @default(0)
  longestStreakDays  Int       @default(0)

  sessions Session[]

  promotionId String?
  /// SetNull (pas Cascade) : supprimer une promotion ne doit jamais supprimer
  /// les comptes participants, seulement les en détacher.
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  portfolios              Portfolio[]
  changeUsage             ChangeUsage[]
  badges                  UserBadge[]
  auditLogs               AuditLog[]
  hallOfFameEntries       HallOfFameEntry[]
  promotionParticipations PromotionParticipant[]
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// Une saison du concours. Les règles sont versionnées ici pour ne jamais
/// affecter l'historique des saisons précédentes (cf. section 6 de CONCEPTION.md).
model Promotion {
  id               String          @id @default(cuid())
  name             String
  status           PromotionStatus @default(DRAFT)
  startDate        DateTime
  endDate          DateTime
  initialCapital   Decimal         @db.Decimal(18, 2)
  /// PromotionRules: { minPositionSize, maxPositionSize, maxPositions, maxCryptoPositions,
  ///                    changeSessionsPerWeek, maxChangesPerSession, freezeHoursBeforeEnd,
  ///                    initializationWindowHours }
  rules            Json
  /// Paragraphe d'introduction du règlement — éditable par l'admin, sinon un texte par
  /// défaut est généré à l'affichage à partir des paramètres de la promotion.
  rulesIntro       String?         @db.Text
  /// Notes/règles complémentaires libres, affichées en fin de règlement.
  rulesCustomNotes String?         @db.Text
  /// Snapshot figé du graphique comparatif à la clôture — { points, participantNames,
  /// participantAvatars }, même forme que les props de PromotionPerformanceChart
  /// (initialCapital déjà porté par ce modèle). Écrit une seule fois par
  /// finalizePromotionClosure (src/lib/promotion-lifecycle.ts), jamais modifié ensuite :
  /// lecture totalement indépendante de PerformanceSnapshot / des prix / des concours actifs.
  /// Nul tant que non clôturée, ou clôturée avant l'introduction de ce champ (voir
  /// scripts/backfill-final-chart-snapshot.ts pour le rattrapage).
  finalChartSnapshot Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  users             User[]
  portfolios        Portfolio[]
  changeSessions    ChangeSession[]
  userBadges        UserBadge[]
  hallOfFameEntries HallOfFameEntry[]
  participants      PromotionParticipant[]
}

enum AssetType {
  STOCK
  CRYPTO
}

model Asset {
  id         String    @id @default(cuid())
  symbol     String    @unique
  name       String
  type       AssetType
  sector     String?
  currency   String    @default("EUR")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  /// Identifiant du fournisseur de prix quand il diffère du ticker affiché
  /// (ex. id CoinGecko "bitcoin" pour le ticker "BTC") — voir
  /// src/lib/prices/providers/coingecko-provider.ts.
  externalId String?
  /// Logo capturé au moment de la recherche de ticker (FMP pour les actions,
  /// CoinGecko pour la crypto) — non recalculable après coup pour la crypto.
  logoUrl    String?

  prices       Price[]
  positions    Position[]
  transactions Transaction[]
}

model Price {
  id        String   @id @default(cuid())
  assetId   String
  timestamp DateTime
  /// Decimal(24, 12) et non (18, 6) : un actif micro-cap (memecoin à ~0,000003 €)
  /// n'a pas de 7e décimale en (18, 6), donc son pas d'arrondi (0,000001 €) vaut
  /// ~33 % du prix — la valeur d'une position bondissait de ±33 % à chaque
  /// changement de quantum. 12 décimales ramènent l'erreur d'arrondi sous 1e-4 %.
  price     Decimal  @db.Decimal(24, 12)
  source    String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, timestamp])
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String
  promotionId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  positions    Position[]
  transactions Transaction[]
  snapshots    PerformanceSnapshot[]

  @@unique([userId, promotionId])
}

/// Un portefeuille peut avoir plusieurs lignes fermées (closedAt renseigné,
/// quantity = 0) sur le même actif au fil du temps (achat, vente totale,
/// rachat plus tard) — mais jamais deux lignes OUVERTES simultanément sur le
/// même actif. Cette contrainte est appliquée par un index unique partiel
/// (`WHERE "closedAt" IS NULL`) créé en SQL brut dans la migration
/// 20260807130000_position_unique_open_per_asset — le DSL Prisma ne supporte
/// pas les index partiels, donc cette contrainte n'apparaît pas ci-dessous.
/// Ne PAS la supprimer par erreur lors d'un futur `prisma migrate dev` (le
/// diff n'en a pas connaissance) ; voir aussi le verrou applicatif dans
/// src/lib/trading/execute-order.ts qui empêche la course qu'elle referme.
model Position {
  id            String    @id @default(cuid())
  portfolioId   String
  assetId       String
  /// quantity en Decimal(30, 12) : avec un prix descendant à 1e-12 (voir Price.price)
  /// et une position jusqu'à 100 000 €, la quantité peut atteindre ~1e17.
  quantity      Decimal   @db.Decimal(30, 12)
  avgEntryPrice Decimal   @db.Decimal(24, 12)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@index([portfolioId])
}

enum TransactionType {
  BUY
  SELL_FULL
  SELL_PARTIAL
  INCREASE
  DECREASE
}

model Transaction {
  id              String          @id @default(cuid())
  portfolioId     String
  assetId         String
  type            TransactionType
  quantity        Decimal         @db.Decimal(30, 12)
  price           Decimal         @db.Decimal(24, 12)
  amount          Decimal         @db.Decimal(18, 2)
  changeSessionId String?
  createdAt       DateTime        @default(now())

  portfolio     Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset         Asset          @relation(fields: [assetId], references: [id])
  changeSession ChangeSession? @relation(fields: [changeSessionId], references: [id])

  @@index([portfolioId])
}

enum ChangeSessionStatus {
  SCHEDULED
  OPEN
  CLOSED
}

/// INITIALIZATION : fenêtre de constitution du portefeuille initial, ouverte
/// automatiquement au lancement de la promotion — changements illimités (voir
/// rules-engine.ts). WEEKLY : session de changement hebdomadaire classique.
enum ChangeSessionKind {
  INITIALIZATION
  WEEKLY
}

model ChangeSession {
  id                       String              @id @default(cuid())
  promotionId              String
  kind                     ChangeSessionKind   @default(WEEKLY)
  weekNumber               Int
  opensAt                  DateTime
  closesAt                 DateTime
  status                   ChangeSessionStatus @default(SCHEDULED)
  maxChangesPerParticipant Int

  promotion    Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  usages       ChangeUsage[]
  transactions Transaction[]

  @@index([promotionId])
}

model ChangeUsage {
  id              String @id @default(cuid())
  changeSessionId String
  userId          String
  changesUsed     Int    @default(0)

  changeSession ChangeSession @relation(fields: [changeSessionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([changeSessionId, userId])
}

/// Valeur de portefeuille pré-calculée (job quotidien) pour un classement et
/// des graphiques rapides même avec beaucoup d'historique.
model PerformanceSnapshot {
  id                  String   @id @default(cuid())
  portfolioId         String
  timestamp           DateTime
  totalValue          Decimal  @db.Decimal(18, 2)
  dailyReturnPct      Decimal  @db.Decimal(9, 6)
  cumulativeReturnPct Decimal  @db.Decimal(9, 6)
  /// Rang au sein de la promotion à l'instant du snapshot, calculé et écrit
  /// dans la même passe que ce snapshot (voir snapshot-service.ts). Nul sur
  /// les lignes historiques antérieures à l'introduction de ce champ — pas de
  /// backfill possible.
  rank                Int?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
}

enum BadgeCategory {
  PERFORMANCE
  TRADING
  RISK_MANAGEMENT
  CONVICTION
  DIVERSIFICATION
  RANKING
  SPECIAL_EVENT
  DISTINCTION
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model Badge {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String
  /// Texte court affiché sur la carte badge verrouillée, ex. "Aucune position
  /// ne dépasse 20% du portefeuille" — distinct de `description` (texte
  /// d'ambiance affiché une fois débloqué).
  condition   String
  category    BadgeCategory
  rarity      BadgeRarity
  icon        String

  userBadges UserBadge[]
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badgeId     String
  promotionId String
  awardedAt   DateTime  @default(now())
  /// Nul tant que la notification de déblocage n'a pas été affichée. Les
  /// badges attribués instantanément (action de trading) sont marqués vus
  /// dans la même requête ; les badges attribués par le cron nocturne
  /// restent nuls jusqu'à affichage côté client (voir UnseenBadgeToaster).
  seenAt      DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, promotionId])
}

/// Traçabilité de toute action admin — répond directement au problème de
/// dérive non tracée de l'ancien Google Sheet.
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
}

/// Historique figé des concours terminés — une ligne par participation à une
/// promotion CLOSED, écrite une seule fois à la clôture (voir
/// src/lib/promotion-lifecycle.ts). Jamais recalculée : contrairement à
/// getLeaderboard, la performance n'y bouge plus au gré du marché. Une même
/// personne apparaît autant de fois qu'elle a participé à des concours
/// terminés — les entrées ne sont jamais fusionnées.
model HallOfFameEntry {
  id             String   @id @default(cuid())
  promotionId    String
  /// SetNull : supprimer un compte ne détruit pas l'historique. userName /
  /// promotionName sont dénormalisés pour rester lisibles sans jointure.
  userId         String?
  userName       String
  promotionName  String
  finalReturnPct Decimal  @db.Decimal(9, 6)
  finalPnlEur    Decimal  @db.Decimal(18, 2)
  finalRank      Int
  /// Snapshot de la photo de profil (data URL) au moment de la clôture — pas
  /// de jointure vers User à la lecture : l'historique reste identique même si
  /// la personne change ou retire sa photo ensuite. Nul si aucune photo.
  avatarUrl      String?  @db.Text
  closedAt       DateTime
  createdAt      DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([promotionId, userId])
  @@index([finalReturnPct])
}

/// Registre d'inscription : une ligne par couple (participant, promotion),
/// écrite quand l'admin inscrit quelqu'un à une promotion, jamais mutée
/// destructivement. Source de vérité du roster (pilote provisionPortfolios) et
/// de l'historique des participations. `User.promotionId` en reste le pointeur
/// dénormalisé "promotion active" (une seule promotion non clôturée à la fois),
/// synchronisé ici à l'inscription.
/// ponytail: double donnée volontaire (ligne de liaison + User.promotionId) —
/// à fusionner si l'app passe un jour à du multi-promotion simultané.
/// `removeParticipant` (/admin/participants) ne remet QUE le pointeur à null,
/// sans toucher à la ligne de liaison ni au portefeuille : divergence assumée
/// (« quitte le concours en cours de route »). `registerParticipants`
/// resynchronise le pointeur quand la ligne existe déjà.
model PromotionParticipant {
  id          String   @id @default(cuid())
  userId      String
  promotionId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([userId, promotionId])
  @@index([promotionId])
}
